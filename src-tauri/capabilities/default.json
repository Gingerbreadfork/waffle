{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main Waffle window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "store:default",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$TEMP/**" }, { "path": "/media/**" }, { "path": "/mnt/**" }, { "path": "/run/media/**" }, { "path": "/Volumes/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$TEMP/**" }, { "path": "/media/**" }, { "path": "/mnt/**" }, { "path": "/run/media/**" }, { "path": "/Volumes/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/**" }, { "path": "/media/**" }, { "path": "/mnt/**" }, { "path": "/run/media/**" }, { "path": "/Volumes/**" }]
    }
  ]
}
