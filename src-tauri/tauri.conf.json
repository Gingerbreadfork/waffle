{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Waffle",
  "version": "0.1.5",
  "identifier": "io.github.gingerbreadfork.waffle",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Waffle",
        "width": 1180,
        "height": 820,
        "minWidth": 520,
        "minHeight": 400,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "backgroundColor": "#faf3e0"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' data: blob: https: http:",
        "style-src": "'self' 'unsafe-inline'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$TEMP/**", "/media/**", "/mnt/**", "/run/media/**", "/Volumes/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4QUE0RDcyNkVDRjQyMEMKUldRTVFzOXVjazJxNkFONmdpempYRW9FOVM2S0ZDZmNBaktRa3Z0cjFISjBPRVZRRExPN2FacDIK",
      "endpoints": [
        "https://github.com/Gingerbreadfork/waffle/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "Waffle",
    "homepage": "https://github.com/Gingerbreadfork/waffle",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown"
        ],
        "name": "Waffle.Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "waffle.desktop",
        "files": {
          "/usr/share/metainfo/io.github.gingerbreadfork.waffle.metainfo.xml": "io.github.gingerbreadfork.waffle.metainfo.xml"
        },
        "section": "editors"
      },
      "rpm": {
        "desktopTemplate": "waffle.desktop",
        "files": {
          "/usr/share/metainfo/io.github.gingerbreadfork.waffle.metainfo.xml": "io.github.gingerbreadfork.waffle.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/io.github.gingerbreadfork.waffle.metainfo.xml": "io.github.gingerbreadfork.waffle.metainfo.xml"
        }
      }
    }
  }
}
